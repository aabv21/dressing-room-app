<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">
  <application>
    <!-- Merged into the app manifest: Play services downloads the subject-segmentation model at install time.
         expo-camera declares the same key with `barcode_ui`; the merged value keeps both (ML Kit reads a
         comma-separated list), and `tools:replace` settles the conflict instead of failing the build. -->
    <meta-data
      android:name="com.google.mlkit.vision.DEPENDENCIES"
      android:value="subject_segment,barcode_ui"
      tools:replace="android:value" />
  </application>
</manifest>
