  "cards": [
    {
      "dot": "cyan",
      "title": "On the phone",
      "items": [
        "Background removal, resize and WebP before any upload",
        "A SQLite queue resumes uploads after a restart or offline",
        "Stats and Diary are computed on the device"
      ]
    },
    {
      "dot": "rose",
      "title": "Isolation",
      "items": [
        "RLS and folder policies: no cross-user reads",
        "Model keys and the service role stay in the functions",
        "Per-user daily quotas before any paid call"
      ]
    },
    {
      "dot": "slate",
      "title": "What leaves Supabase",
      "items": [
        "Claude: a 784 px cut-out and enum values",
        "Jev: height, age and body buckets, never photos",
        "Open-Meteo: the city name or its coordinates"
      ]
    }
