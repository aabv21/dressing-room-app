  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.2.1",
    "expo-doctor": "^1.21.6",
    "jest": "~30.5.2",
    "jest-expo": "58.0.13",
    "jiti": "^2.7.0",
    "sharp": "^0.35.5",
    "supabase": "2.122.1",
    "test-renderer": "1.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --selectProjects app scripts functions",
    "test:int": "NODE_OPTIONS=--experimental-vm-modules jest --selectProjects integration --runInBand",
    "check:expo": "expo install --check",
    "perf:generate": "node scripts/perf-fixtures.ts generate",
    "perf:serve": "node scripts/perf-fixtures.ts serve",
    "db:start": "node scripts/db-start.ts",
    "db:start:ci": "node scripts/db-start.ts -x studio,realtime,vector,logflare,imgproxy",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local > src/lib/database.types.ts",
    "env:local": "node scripts/env-local.ts",
    "check:supply-chain": "node scripts/check-supply-chain.ts",
    "calibrate": "node scripts/calibrate.ts",
    "backup": "node scripts/backup.ts",
    "e2e": "node scripts/e2e.ts"
  }
