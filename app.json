{
  "expo": {
    "name": "Dressing Room",
    "slug": "dressing-room-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dressingroom",
    "userInterfaceStyle": "light",
    "locales": {
      "en": "./locales/en.json",
      "es": "./locales/es.json"
    },
    "ios": {
      "bundleIdentifier": "com.aabv21.dressingroom",
      "icon": "./assets/expo.icon",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Loads test images from your computer during development.",
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "com.aabv21.dressingroom",
      "adaptiveIcon": {
        "backgroundColor": "#7c3aed",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      ["expo-localization", { "supportedLocales": ["en", "es"] }],
      "expo-sqlite",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Dressing Room uses the photos you pick to add clothes to your closet or to compare a piece with it."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Dressing Room uses your camera to photograph clothes for your closet or to compare a piece with it."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Dressing Room uses the microphone only while you tap to dictate a city, an occasion or a message to your stylist.",
          "speechRecognitionPermission": "Dressing Room turns what you dictate into text to fill in a city, pick an occasion or write to your stylist."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Dressing Room uses your location once to find your city, so outfit suggestions can match the weather.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "locationFullAccuracyPermission": false,
          "motionUsagePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#7c3aed",
          "enableRemoteNotifications": false
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.988226077161-2mj7u7trmakoadvm8dtu8d77tej74ko2"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "c917e118-7b03-4b77-976b-d3c6eb089147"
      }
    },
    "owner": "aabv211996"
  }
}
